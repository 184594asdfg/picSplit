.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f8f9;
  padding: 0;
  box-sizing: border-box;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: #fff;
  border-bottom: 1px solid #e5e5e5;
}

.nav-back {
  font-size: 24px;
  color: #333;
}

.nav-title {
  font-size: 18px;
  font-weight: 500;
  color: #000;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 0 20rpx;
  padding-bottom: 400rpx;
  box-sizing: border-box;
  min-height: 0;
}

.grid-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  width: 100%;
}

.preview-area {
  width: 95%;
  padding-bottom: 95%;
  position: relative;
  overflow: hidden;
}

.preview-area::after {
  content: '';
  position: absolute;
  top: 1rpx;
  left: 1rpx;
  right: 1rpx;
  bottom: 1rpx;
  background: #000;
  z-index: 0;
}

.preview-image {
  position: absolute;
  top: 0;
  left: 0;
}

.preview-image.upload-image {
  z-index: 1;
  pointer-events: auto;
}

.preview-image.shape-image {
  z-index: 2;
  pointer-events: none;
  width: 100%;
  height: 100%;
}

.preview-image.shape-image.screen-blend {
  mix-blend-mode: screen;
}

.shape-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-top: 10rpx;
  width: 100%;
  box-sizing: border-box;
  z-index: 100;
}


.section-title {
  font-size: 32rpx;
  color: #333;
  padding: 0 40rpx;
  margin-bottom: 12rpx;
  font-weight: 300;
}

.shape-scroll {
  white-space: nowrap;
  overflow-x: auto;
  padding: 40rpx 30rpx;
  border-top: 2rpx solid #eee;
}

.shape-scroll::-webkit-scrollbar {
  display: none;
}

.shape-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-right: 30rpx;
  width: 80rpx;
  height: 80rpx;
  border-radius: 1rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
}

.shape-item.selected {
  border-color: #ff4d4f;
  transform: scale(1.05);
}

.shape-item:last-child {
  margin-right: 0;
}

.shape-icon {
  width: 68rpx;
  height: 68rpx;
}

.bottom-bar {
  display: flex;
  gap: 30rpx;
  padding: 10rpx 20rpx;
  background: #fff;
  padding-bottom: 40rpx;
  box-sizing: border-box;
  width: 100%;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 350;
  transition: all 0.2s ease;
}

.btn-outline {
  background: #fff;
  border: 2rpx solid #1890ff;
}

.btn-outline .btn-text {
  color: #1890ff;
}

.btn-primary {
  background: #1890ff;
}

.btn-primary .btn-text {
  color: #fff;
}

.btn:active {
  opacity: 0.8;
}

.cut-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 300px;
  height: 300px;
  pointer-events: none;
  z-index: -1;
}
