<view class="container">
  <view class="main-content">
    <view class="grid-container">
      <view class="preview-area">
        <image
          class="preview-image upload-image"
          wx:if="{{selectedImage}}"
          src="{{selectedImage}}"
          mode="aspectFit"
          style="width:{{imgW}}px;height:{{imgH}}px;left:{{imgX}}px;top:{{imgY}}px;"
          bindtouchstart="touchStart"
          catchtouchmove="touchMove"
          bindtouchend="touchEnd"
        ></image>
        <image class="preview-image shape-image screen-blend" src="{{currentShapeIcon}}" mode="aspectFit"></image>
      </view>
    </view>

    <view class="shape-section">
      <view class="section-title">图形</view>
      <view class="shape-scroll">
        <view
          wx:for="{{shapes}}"
          wx:key="id"
          class="shape-item {{selectedShape === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSelectShape"
        >
          <image class="shape-icon" src="{{item.icon}}" mode="aspectFit"></image>
        </view>
      </view>
      <view class="bottom-bar">
        <view class="btn btn-outline" bindtap="onChooseImage">
          <text class="btn-text">选择图片</text>
        </view>
        <view class="btn btn-primary" bindtap="onSaveImage">
          <text class="btn-text">保存图片</text>
        </view>
      </view>
    </view>
  </view>
</view>