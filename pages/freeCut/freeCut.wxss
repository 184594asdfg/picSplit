.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #000;
}

.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 100;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 300;
}

.nav-placeholder {
  width: 60rpx;
}

.preview {
  flex: 1;
  background: #000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 20rpx 500rpx;
}

.preview-box {
  width: 95%;
  max-height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 8rpx;
}

.preview-image {
  width: 100%;
  height: 800rpx;
  display: block;
}

.preview-placeholder {
  width: 100%;
  height: 800rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1a1a1a;
  border-radius: 8rpx;
}

.placeholder-text {
  color: #666;
  font-size: 28rpx;
}

.grid-overlay {
  position: absolute;
  inset: 0;
  display: grid;
  box-sizing: border-box;
  border-right: 1px dashed #000;
  border-bottom: 1px dashed #000;
}

.grid-cell {
  box-sizing: border-box;
  border-top: 1px dashed #000;
  border-left: 1px dashed #000;
  background-color: transparent;
}

.grid-overlay div.selected {
  background-color: rgba(0,0,0,0.15);
}

.operation {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #f7f7f7;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0 0 60rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  z-index: 10;
}

.tab-bar {
  background-color: #e5e5e5;
  display: flex;
  align-items: center;
  padding: 10rpx 0rpx 0rpx 32rpx;
  border-radius: 40rpx 40rpx 0 0;
}

.tab-icon {
  width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #666;
}

.tab-group {
  flex: 1;
  display: flex;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 15rpx 15rpx 0rpx 0rpx;
  font-size: 28rpx;
  color: #888;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  background-color: transparent;
}

.tab-item.active {
  background-color: #f7f7f7;
  color: #000;
  font-weight: bold;
}

.mode-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx 32rpx;
}

.mode-group {
  display: flex;
  background-color: #e5e5e5;
  border-radius: 40rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.mode-item {
  padding: 0rpx 30rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #888;
  min-height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-item.active {
  background-color: #fff;
  color: #000;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

/* 网格图标：彻底无重叠 最终版 */
.grid-options {
  display: flex;
  justify-content: space-between;
  text-align: center;
  font-size: 24rpx;
  gap: 16rpx;
  padding: 0 32rpx;
}

.grid-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.icon-box {
  width: 50rpx;
  height: 50rpx;
  display: grid;
  border-right: 2rpx solid #000;
  border-bottom: 2rpx solid #000;
  box-sizing: border-box;
}

.grid-inner-cell {
  border-top: 2rpx solid #000;
  border-left: 2rpx solid #000;
  box-sizing: border-box;
}

.grid-text {
  color: #000;
  font-size: 24rpx;
}

.grid-item.active .icon-box {
  border-right-color: #ff3b30;
  border-bottom-color: #ff3b30;
}
.grid-item.active .grid-inner-cell {
  border-top-color: #ff3b30;
  border-left-color: #ff3b30;
}
.grid-item.active .grid-text {
  color: #007aff;
  font-weight: 500;
}

.bottom-bar {
  display: flex;
  gap: 30rpx;
  padding: 8rpx 32rpx 0;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 350;
  transition: all 0.2s ease;
}

.btn-outline {
  background: #fff;
  border: 2rpx solid #1890ff;
}

.btn-outline .btn-text {
  color: #1890ff;
}

.btn-primary {
  background: #1890ff;
}

.btn-primary .btn-text {
  color: #fff;
}

.btn:active {
  opacity: 0.8;
}