/* 分割线外层：加宽触摸区域 */
.touch-h {
  position: absolute;
  left: 0;
  right: 0;
  height: 20rpx;
  transform: translateY(-10rpx);
  display: flex;
  align-items: center;
}
.touch-v {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 20rpx;
  transform: translateX(-10rpx);
  display: flex;
  justify-content: center;
}

/* 真正的分割线（视觉不变） */
.divider {
  position: relative;
  z-index: 10;
}
.horizontal-line {
  width: 100%;
  height: 4rpx;
  background-image: linear-gradient(to right, #000 0, #000 8rpx, #fff 8rpx, #fff 16rpx);
  background-size: 16rpx 100%;
}
.vertical-line {
  height: 100%;
  width: 4rpx;
  background-image: linear-gradient(to bottom, #000 0, #000 8rpx, #fff 8rpx, #fff 16rpx);
  background-size: 100% 16rpx;
}

.img-wrap-lines {
  position: absolute;
  pointer-events: none;
}
.img-wrap-lines .touch-h,
.img-wrap-lines .touch-v {
  pointer-events: auto;
}

/* 以下样式保持不变 */
page { padding: 0; margin: 0; }
.container { height: 100vh; display: flex; flex-direction: column; background-color: #000; overflow: hidden; }
.preview { flex:1; background:#000; display:flex; align-items:center; justify-content:center; }
.preview-box { width:100%; height:100%; position:relative; display:flex; align-items:center; justify-content:center; }
.image-container { position:relative; width:90%; height:90%; display:flex; align-items:center; justify-content:center; }
.preview-image { width:100%; height:100%; object-fit:contain; display:block; }
.grid-overlay { position:absolute; display:grid; box-sizing:border-box; pointer-events:none; }
.grid-overlay.fixed { border:2rpx solid #000; }
.grid-cell { position:relative; box-sizing:border-box; }
.grid-cell.fixed::before { content:''; position:absolute; left:0; right:0; bottom:0; height:4rpx; background-image:linear-gradient(to right, #000 0, #000 8rpx, #fff 8rpx, #fff 16rpx); background-size:16rpx 100%; }
.grid-cell.fixed::after { content:''; position:absolute; right:0; top:0; bottom:0; width:4rpx; background-image:linear-gradient(to bottom, #000 0, #000 8rpx, #fff 8rpx, #fff 16rpx); background-size:100% 16rpx; }
.grid-cell.no-bottom-border::before { display:none; }
.grid-cell.no-right-border::after { display:none; }
.grid-cell.selected { background:rgba(0,0,0,0.15); }
.preview-placeholder { width:100%; min-height:300rpx; background:#1a1a1a; border-radius:8rpx; display:flex; align-items:center; justify-content:center; }
.placeholder-text { color:#666; font-size:28rpx; }
.operation { flex-shrink:0; background:#f7f7f7; border-radius:40rpx 40rpx 0 0; }
.tab-bar { background:#e5e5e5; display:flex; padding:10rpx 0 0 32rpx; border-radius:40rpx 40rpx 0 0; }
.tab-icon { width:60rpx; text-align:center; font-size:32rpx; color:#666; }
.tab-group { flex:1; display:flex; gap:8rpx; }
.tab-item { flex:1; text-align:center; padding:12rpx 0; border-radius:15rpx 15rpx 0 0; font-size:28rpx; color:#888; }
.tab-item.active { background:#f7f7f7; color:#000; font-weight:bold; }
.mode-bar { padding:20rpx 32rpx; }
.mode-group { display:flex; background:#e5e5e5; border-radius:40rpx; padding:6rpx; gap:6rpx; }
.mode-item { padding:0 30rpx; border-radius:36rpx; font-size:24rpx; color:#888; min-height:45rpx; }
.mode-item.active { background:#fff; color:#000; }
.grid-options { display:flex; gap:80rpx; padding:0 0 40rpx 32rpx; overflow-x:auto; }
.grid-item { flex-shrink:0; width:70rpx; display:flex; flex-direction:column; align-items:center; gap:12rpx; }
.icon-box { width:50rpx; height:50rpx; display:grid; border-right:2rpx solid #000; border-bottom:2rpx solid #000; box-sizing:border-box; }
.grid-inner-cell { border-top:2rpx solid #000; border-left:2rpx solid #000; box-sizing:border-box; }
.grid-text { font-size:24rpx; }
.grid-item.active .icon-box { border-right-color:#ff3b30; border-bottom-color:#ff3b30; }
.grid-item.active .grid-inner-cell { border-left-color:#ff3b30; border-top-color:#ff3b30; }
.grid-item.active .grid-text { color:#007aff; font-weight:500; }