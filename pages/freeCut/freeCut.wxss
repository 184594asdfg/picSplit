page {
  padding: 0;
  margin: 0;
}

.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #000;
  overflow: hidden;
  padding: 0;
  margin: 0;
}

.header {
  flex-shrink: 0;
  background-color: #fff;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 36rpx;
  color: #333;
}

.nav-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 300;
}

.nav-placeholder {
  width: 60rpx;
}

.preview {
  flex: 1;
  background: #000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  box-sizing: border-box;
  min-height: 0;
}

.preview-box {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  border-radius: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

.image-container {
  position: relative;
  width: 90%;
  height: 90%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.preview-image {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: contain;
}

.grid-overlay {
  position: absolute;
  box-sizing: border-box;
  pointer-events: none;
  overflow: hidden;
}

.grid-frame {
  position: absolute;
  display: grid;
  box-sizing: border-box;
  pointer-events: auto;
}

/* 固定模式下的完整实线外框（提示可拖动的整体边界） */
.grid-frame.fixed {
  outline: 2rpx solid rgba(255, 255, 255, 0.7);
  outline-offset: -1rpx;
}

.preview-placeholder {
  width: 100%;
  min-height: 300rpx;
  max-height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #1a1a1a;
  border-radius: 8rpx;
}

.placeholder-text {
  color: #666;
  font-size: 28rpx;
}



.grid-frame .grid-cell {
  pointer-events: auto;
}

/* 自由模式：分割线热区与视觉指示 */
.divider {
  position: absolute;
  pointer-events: auto;
  z-index: 5;
}

.divider-vertical {
  top: 0;
  bottom: 0;
  width: 40rpx;
  margin-left: -20rpx;
}

.divider-vertical::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background-color: rgba(0, 122, 255, 0.7);
  transform: translateX(-50%);
}

.divider-horizontal {
  left: 0;
  right: 0;
  height: 40rpx;
  margin-top: -20rpx;
}

.divider-horizontal::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: rgba(0, 122, 255, 0.7);
  transform: translateY(-50%);
}

.grid-cell {
  box-sizing: border-box;
  background-color: transparent;
  position: relative;
}

/* 使用linear-gradient绘制等距黑方块+白方块 - 参考test2.html */
.grid-cell::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background-image: linear-gradient(
    to right,
    #000 0px,
    #000 8rpx,
    #fff 8rpx,
    #fff 16rpx
  );
  background-size: 16rpx 100%;
  background-repeat: repeat-x;
}

.grid-cell::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 4rpx;
  background-image: linear-gradient(
    to bottom,
    #000 0px,
    #000 8rpx,
    #fff 8rpx,
    #fff 16rpx
  );
  background-size: 100% 16rpx;
  background-repeat: repeat-y;
}

/* 最后一行取消底边线 */
.grid-cell.no-bottom-border::before {
  display: none;
}

/* 最后一列取消右边线 */
.grid-cell.no-right-border::after {
  display: none;
}

.grid-cell.selected {
  background-color: rgba(0, 0, 0, 0.15);
}

.operation {
  flex-shrink: 0;
  background-color: #f7f7f7;
  border-radius: 40rpx 40rpx 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tab-bar {
  background-color: #e5e5e5;
  display: flex;
  align-items: stretch;
  padding: 10rpx 0 0 0;
  border-radius: 40rpx 40rpx 0 0;
  gap: 4rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 15rpx 15rpx 0 0;
  font-size: 28rpx;
  color: #888;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  background-color: transparent;
}

.tab-item.active {
  background-color: #f7f7f7;
  color: #000;
  font-weight: bold;
}

.tab-item.tab-icon {
  font-size: 32rpx;
  color: #666;
}

.tab-item.tab-confirm {
  color: #1890ff;
  font-weight: 600;
}

.tab-item.tab-confirm:active {
  opacity: 0.6;
}

.mode-bar {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 20rpx 32rpx;
}

.mode-group {
  display: flex;
  background-color: #e5e5e5;
  border-radius: 40rpx;
  padding: 6rpx;
  gap: 6rpx;
}

.mode-item {
  padding: 0rpx 30rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #888;
  min-height: 45rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mode-item.active {
  background-color: #fff;
  color: #000;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.1);
}

/* 网格图标：彻底无重叠 最终版 */
.grid-options {
  display: flex;
  text-align: center;
  font-size: 24rpx;
  gap: 80rpx;
  padding: 0 0rpx 40rpx 32rpx;
  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.grid-item {
  flex-shrink: 0;
  width: 70rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 0;
}

.icon-box {
  width: 50rpx;
  height: 50rpx;
  display: grid;
  border-right: 2rpx solid #000;
  border-bottom: 2rpx solid #000;
  box-sizing: border-box;
}

.grid-inner-cell {
  border-top: 2rpx solid #000;
  border-left: 2rpx solid #000;
  box-sizing: border-box;
}

.grid-text {
  color: #000;
  font-size: 24rpx;
}

.grid-item.active .icon-box {
  border-right-color: #ff3b30;
  border-bottom-color: #ff3b30;
}
.grid-item.active .grid-inner-cell {
  border-top-color: #ff3b30;
  border-left-color: #ff3b30;
}
.grid-item.active .grid-text {
  color: #007aff;
  font-weight: 500;
}


.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 350;
  transition: all 0.2s ease;
}

.btn-outline {
  background: #fff;
  border: 2rpx solid #1890ff;
}

.btn-outline .btn-text {
  color: #1890ff;
}

.btn-primary {
  background: #1890ff;
}

.btn-primary .btn-text {
  color: #fff;
}

.btn:active {
  opacity: 0.8;
}

.cut-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 300px;
  height: 300px;
  pointer-events: none;
  z-index: -1;
}