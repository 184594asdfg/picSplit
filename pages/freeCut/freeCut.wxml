<view class="container">

  <view class="preview">
    <view class="preview-box">
      <view wx:if="{{!selectedImage}}" class="preview-placeholder" bindtap="onChooseImage">
        <text class="placeholder-text">点击选择图片</text>
      </view>
      <view class="image-container" wx:if="{{selectedImage}}">
        <image
          class="preview-image"
          src="{{selectedImage}}"
          mode="aspectFit"
          bindload="onImageLoad"
        ></image>
        <view
          class="grid-overlay {{modeType}}"
          style="{{gridOverlayStyle}}"
        >
          <view
            class="grid-frame {{modeType}}"
            style="{{frameStyle}}"
            catchtouchstart="onFrameTouchStart"
            catchtouchmove="onFrameTouchMove"
            catchtouchend="onFrameTouchEnd"
            catchtouchcancel="onFrameTouchEnd"
          >
            <view
              wx:for="{{gridCells}}"
              wx:key="index"
              class="grid-cell {{selectedCells.includes(item.index) ? 'selected' : ''}} {{item.isFirstRow ? 'no-top-border' : ''}} {{item.isFirstCol ? 'no-left-border' : ''}} {{item.isLastCol ? 'no-right-border' : ''}} {{item.isLastRow ? 'no-bottom-border' : ''}}"
              data-index="{{item.index}}"
              bindtap="onCellTap"
            ></view>
          </view>

          <block wx:if="{{modeType === 'free'}}">
            <view
              wx:for="{{colDividers}}"
              wx:for-item="pos"
              wx:for-index="i"
              wx:key="i"
              class="divider divider-vertical"
              style="left:{{pos}}%;"
              data-type="col"
              data-index="{{i}}"
              catchtouchstart="onDividerTouchStart"
              catchtouchmove="onDividerTouchMove"
              catchtouchend="onDividerTouchEnd"
              catchtouchcancel="onDividerTouchEnd"
            ></view>
            <view
              wx:for="{{rowDividers}}"
              wx:for-item="pos"
              wx:for-index="i"
              wx:key="i"
              class="divider divider-horizontal"
              style="top:{{pos}}%;"
              data-type="row"
              data-index="{{i}}"
              catchtouchstart="onDividerTouchStart"
              catchtouchmove="onDividerTouchMove"
              catchtouchend="onDividerTouchEnd"
              catchtouchcancel="onDividerTouchEnd"
            ></view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view class="operation">
    <view class="tab-bar">
      <view class="tab-item tab-icon">❔</view>
      <view
        wx:for="{{tabList}}"
        wx:key="index"
        class="tab-item {{activeTab === item.index ? 'active' : ''}}"
        data-index="{{item.index}}"
        bindtap="onTabChange"
      >{{item.name}}</view>
      <view class="tab-item tab-icon tab-confirm" bindtap="onConfirm">✓</view>
    </view>

    <view class="mode-bar">
      <view class="mode-group">
        <view
          class="mode-item {{modeType === 'fixed' ? 'active' : ''}}"
          data-type="fixed"
          bindtap="onModeChange"
        >固定</view>
        <view
          class="mode-item {{modeType === 'free' ? 'active' : ''}}"
          data-type="free"
          bindtap="onModeChange"
        >自由</view>
      </view>
    </view>

    <view class="grid-options">
      <view
        class="grid-item {{!isCustomGridActive && activeGridIndex === index ? 'active' : ''}}"
        wx:for="{{activeTab === 0 ? gridList : activeTab === 1 ? verticalList : horizontalList}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onGridSelect"
      >
        <view class="icon-box" style="grid-template-columns:repeat({{item.cols}},1fr);grid-template-rows:repeat({{item.rows}},1fr);">
          <view wx:for="{{item.cols * item.rows}}" wx:key="item" class="grid-inner-cell"></view>
        </view>
        <view class="grid-text">{{item.name}}</view>
      </view>

      <view
        class="grid-item grid-item-custom {{isCustomGridActive ? 'active' : ''}}"
        bindtap="onCustomGridTap"
      >
        <view class="icon-box icon-custom">
          <image class="custom-grid-icon" src="{{customGridIcon}}" mode="aspectFit" />
        </view>
        <view class="grid-text">{{customGridName}}</view>
      </view>
    </view>


  </view>

  <canvas type="2d" id="freeCutCanvas" class="cut-canvas"></canvas>

  <view class="custom-modal-mask" wx:if="{{showCustomModal}}" catchtouchmove="preventMove">
    <view class="custom-modal">
      <view class="custom-modal-title">自定义网格</view>
      <view class="custom-picker-header">
        <text class="custom-picker-title">列数</text>
        <text class="custom-picker-title">行数</text>
      </view>
      <picker-view
        class="custom-picker-view"
        indicator-class="custom-picker-indicator"
        value="{{customPickerValue}}"
        bindchange="onCustomPickerChange"
      >
        <picker-view-column>
          <view wx:for="{{customGridOptions}}" wx:key="*this" class="custom-picker-item">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{customGridOptions}}" wx:key="*this" class="custom-picker-item">{{item}}</view>
        </picker-view-column>
      </picker-view>
      <view class="custom-modal-actions">
        <view class="custom-modal-btn cancel" bindtap="onCustomModalCancel">取消</view>
        <view class="custom-modal-btn confirm" bindtap="onCustomModalConfirm">确定</view>
      </view>
    </view>
  </view>
</view>
