<view class="container">

  <view class="preview">
    <view class="preview-box">
      <view wx:if="{{!selectedImage}}" class="preview-placeholder" bindtap="onChooseImage">
        <text class="placeholder-text">点击选择图片</text>
      </view>
      <view class="image-container" wx:if="{{selectedImage}}">
        <image
          class="preview-image"
          src="{{selectedImage}}"
          mode="aspectFit"
          bindload="onImageLoad"
        ></image>
        <view
          class="grid-overlay {{modeType}}"
          style="grid-template-columns:repeat({{gridCols}},1fr);grid-template-rows:repeat({{gridRows}},1fr);{{gridOverlayStyle}}"
        >
          <view 
            wx:for="{{gridCells}}" 
            wx:key="index"
            class="grid-cell {{modeType}} {{selectedCells.includes(item.index) ? 'selected' : ''}} {{item.isFirstRow ? 'no-top-border' : ''}} {{item.isFirstCol ? 'no-left-border' : ''}} {{item.isLastCol ? 'no-right-border' : ''}} {{item.isLastRow ? 'no-bottom-border' : ''}}"
            data-index="{{item.index}}"
            bindtap="onCellTap"
          ></view>
        </view>
      </view>
    </view>
  </view>

  <view class="operation">
    <view class="tab-bar">
      <view class="tab-icon">❔</view>
      <view class="tab-group">
        <view
          wx:for="{{tabList}}"
          wx:key="index"
          class="tab-item {{activeTab === item.index ? 'active' : ''}}"
          data-index="{{item.index}}"
          bindtap="onTabChange"
        >{{item.name}}</view>
      </view>
      <view class="tab-icon">✓</view>
    </view>

    <view class="mode-bar">
      <view class="mode-group">
        <view
          class="mode-item {{modeType === 'fixed' ? 'active' : ''}}"
          data-type="fixed"
          bindtap="onModeChange"
        >固定</view>
        <view
          class="mode-item {{modeType === 'free' ? 'active' : ''}}"
          data-type="free"
          bindtap="onModeChange"
        >自由</view>
      </view>
    </view>

    <view class="fixed-controls" wx:if="{{modeType === 'fixed'}}">
      <view class="control-item">
        <text class="control-label">横向份数</text>
        <view class="stepper">
          <view class="stepper-btn" bindtap="onFixedColsChange" data-delta="-1">-</view>
          <view class="stepper-value">{{fixedCols}}</view>
          <view class="stepper-btn" bindtap="onFixedColsChange" data-delta="1">+</view>
        </view>
      </view>
      <view class="control-item">
        <text class="control-label">纵向份数</text>
        <view class="stepper">
          <view class="stepper-btn" bindtap="onFixedRowsChange" data-delta="-1">-</view>
          <view class="stepper-value">{{fixedRows}}</view>
          <view class="stepper-btn" bindtap="onFixedRowsChange" data-delta="1">+</view>
        </view>
      </view>
    </view>

    <view class="grid-options" wx:if="{{modeType === 'free'}}">
      <view
        class="grid-item {{activeGridIndex === index ? 'active' : ''}}"
        wx:for="{{activeTab === 0 ? gridList : activeTab === 1 ? verticalList : horizontalList}}"
        wx:key="index"
        data-index="{{index}}"
        bindtap="onGridSelect"
      >
        <view class="icon-box" style="grid-template-columns:repeat({{item.cols}},1fr);grid-template-rows:repeat({{item.rows}},1fr);">
          <view wx:for="{{item.cols * item.rows}}" wx:key="item" class="grid-inner-cell"></view>
        </view>
        <view class="grid-text">{{item.name}}</view>
      </view>
    </view>


  </view>
</view>