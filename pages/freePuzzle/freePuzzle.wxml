<view class="page-container">
  <view class="preview-area">
    <view class="preview-stage">
      <view class="puzzle-frame" style="width:{{frameW}}px;height:{{frameH}}px;">
        <view
          class="puzzle-cell {{cellImages[index].src && draggingIdx !== index ? 'has-img' : ''}}"
          wx:for="{{cells}}"
          wx:key="idx"
          data-index="{{index}}"
          style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.w}}px;height:{{item.h}}px;padding:{{imgPad}}px;"
          bindtouchstart="onCellTouchStart"
          bindtouchmove="onCellTouchMove"
          bindtouchend="onCellTouchEnd"
          bindtouchcancel="onCellTouchEnd">
          <view class="cell-inner">
            <image
              wx:if="{{cellImages[index].src && draggingIdx !== index}}"
              class="cell-img"
              src="{{cellImages[index].src}}"
              mode="scaleToFill"
              style="left:{{cellImages[index].offsetX}}px;top:{{cellImages[index].offsetY}}px;width:{{cellImages[index].dispW}}px;height:{{cellImages[index].dispH}}px;"
            />
          </view>
        </view>
      </view>
    </view>

    <view
      wx:if="{{draggingIdx >= 0}}"
      class="drag-floating"
      style="left:{{floatX}}px;top:{{floatY}}px;width:{{floatW}}px;height:{{floatH}}px;padding:{{imgPad}}px;">
      <view class="cell-inner">
        <image
          wx:if="{{cellImages[draggingIdx].src}}"
          class="cell-img"
          src="{{cellImages[draggingIdx].src}}"
          mode="scaleToFill"
          style="left:{{cellImages[draggingIdx].offsetX}}px;top:{{cellImages[draggingIdx].offsetY}}px;width:{{cellImages[draggingIdx].dispW}}px;height:{{cellImages[draggingIdx].dispH}}px;"
        />
      </view>
    </view>

    <canvas type="2d" id="saveCanvas" class="save-canvas"></canvas>
  </view>

  <view class="bottom-panel">
    <view class="template-section">
      <view class="section-title">模板</view>
      <scroll-view class="template-scroll" scroll-x="true" show-scrollbar="false">
        <view class="template-list">

          <view class="left-template">
            <view class="template-item" bindtap="onLeftIconChange">
              <view class="box small-box">
                <view class="left-icon-inner {{leftBorderType}}">
                  {{leftLetter}}
                </view>
              </view>
              <text class="item-text">{{leftText}}</text>
            </view>
            <view class="split-line"></view>
          </view>

          <view class="template-item {{currentTemplate==1?'active':''}}" data-index="1" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-h mid-h"></view></view>
          </view>
          <view class="template-item {{currentTemplate==2?'active':''}}" data-index="2" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-v mid-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==3?'active':''}}" data-index="3" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-h one-h"></view><view class="line-h two-h"></view></view>
          </view>
          <view class="template-item {{currentTemplate==4?'active':''}}" data-index="4" bindtap="handleTemplateChange">
            <view class="box ratio-1-1"><view class="line-h mid-h"></view><view class="line-v mid-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==5?'active':''}}" data-index="5" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-h one-h"></view><view class="line-h two-h"></view><view class="line-v mid-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==6?'active':''}}" data-index="6" bindtap="handleTemplateChange">
            <view class="box ratio-1-1"><view class="line-h one-h"></view><view class="line-h two-h"></view><view class="line-v one-v"></view><view class="line-v two-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==7?'active':''}}" data-index="7" bindtap="handleTemplateChange">
            <view class="box ratio-5-3"><view class="line-v mid-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==8?'active':''}}" data-index="8" bindtap="handleTemplateChange">
            <view class="box ratio-5-3"><view class="line-v one-v"></view><view class="line-v two-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==9?'active':''}}" data-index="9" bindtap="handleTemplateChange">
            <view class="box ratio-2-1"><view class="line-v f1-v"></view><view class="line-v f2-v"></view><view class="line-v f3-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==10?'active':''}}" data-index="10" bindtap="handleTemplateChange">
            <view class="box ratio-5-3"><view class="line-h mid-h"></view><view class="line-v one-v"></view><view class="line-v two-v"></view></view>
          </view>
          <view class="template-item {{currentTemplate==11?'active':''}}" data-index="11" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-h mid-h"></view></view>
          </view>
          <view class="template-item {{currentTemplate==12?'active':''}}" data-index="12" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-h one-h"></view><view class="line-h two-h"></view></view>
          </view>
          <view class="template-item {{currentTemplate==13?'active':''}}" data-index="13" bindtap="handleTemplateChange">
            <view class="box ratio-4-5"><view class="line-h q1"></view><view class="line-h q2"></view><view class="line-h q3"></view></view>
          </view>
          <view class="template-item {{currentTemplate==14?'active':''}}" data-index="14" bindtap="handleTemplateChange">
            <view class="box ratio-5-3"><view class="line-v mid-v"></view></view>
          </view>

        </view>
      </scroll-view>
    </view>

    <view class="action-buttons">
      <button class="select-btn" bindtap="handleSelectImage">选择图片(1~9张)</button>
      <button class="save-btn" bindtap="handleSaveImage">保存图片</button>
    </view>
  </view>
</view>