page {
  background: #f5f5f5;
}
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-black-bg {
  width: 95%;
  height: 90%;
  background: #000;
  border-radius: 16rpx;
}
.bottom-panel {
  background: #fff;
  border-top-left-radius: 26rpx;
  border-top-right-radius: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.collapse-btn {
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.arrow-icon {
  font-size: 30rpx;
  color: #ccc;
}
.template-section {
  padding: 0 30rpx 40rpx;
}
.section-title {
  font-size: 30rpx;
  color: #007aff;
  margin-bottom: 26rpx;
  display: flex;
  align-items: center;
  height: 60rpx;
  line-height: 60rpx;
  border-bottom: 2rpx solid #e5e5e5;
}
.template-scroll {
  white-space: nowrap;
}
.template-list {
  display: flex;
  align-items: center;
}

.left-template {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.split-line {
  width: 2rpx;
  height: 70rpx;
  background: #ccc !important;
  margin-left: 20rpx;
  display: block;
}

.template-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 25rpx;
}

.small-box {
  width: 60rpx !important;
  height: 60rpx !important;
}

.item-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.ratio-4-5 { width: 80rpx; height: 100rpx; }
.ratio-1-1 { width: 100rpx; height: 100rpx; }
.ratio-5-3 { width: 125rpx; height: 75rpx; }
.ratio-2-1 { width: 140rpx; height: 70rpx; }

.box {
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  background: #fff;
  position: relative;
  box-sizing: border-box;
}

.line-h {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: #ccc;
}
.mid-h { top: 50%; }
.one-h { top: 33.333%; }
.two-h { top: 66.666%; }
.q1 { top: 25%; }
.q2 { top: 50%; }
.q3 { top: 75%; }

.line-v {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: #ccc;
}
.mid-v { left: 50%; }
.one-v { left: 33.333%; }
.two-v { left: 66.666%; }
.f1-v { left: 25%; }
.f2-v { left: 50%; }
.f3-v { left: 75%; }

/* 选中仅边框变色 不填满背景 */
.template-item.active .box{
  border-color: #ff7a9c;
  background: #fff;
  border-width: 3rpx;
}
.template-item.active .line-h,
.template-item.active .line-v {
  background: #ff7a9c;
}

.left-icon-inner {
  position: absolute;
  inset: 0;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #666;
}
.line-none {
  background: linear-gradient(135deg, transparent 48%, #ccc 48%, #ccc 52%, transparent 52%);
  border: none;
}
.line-small,
.line-medium,
.line-large {
  border: none;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 0 30rpx 0rpx;
}
.select-btn, .save-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.select-btn {
  border: 2rpx solid #007aff;
  color: #007aff;
  background: #fff;
}
.save-btn {
  background: #007aff;
  color: #fff;
}