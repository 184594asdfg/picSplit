page {
  background: #f5f5f5;
}
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-black-bg {
  width: 95%;
  height: 90%;
  background: #000;
  border-radius: 16rpx;
}
.bottom-panel {
  background: #fff;
  border-top-left-radius: 26rpx;
  border-top-right-radius: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.collapse-btn {
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.arrow-icon {
  font-size: 30rpx;
  color: #ccc;
}
.template-section {
  padding: 0 30rpx 40rpx;
}
.section-title {
  font-size: 34rpx;
  color: #007aff;
  margin-bottom: 26rpx;
}
.template-scroll {
  white-space: nowrap;
}
.template-list {
  display: flex;
  gap: 70rpx;
  align-items: center;
}
.template-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ratio-4-5 { width: 80rpx; height: 100rpx; }
.ratio-1-1 { width: 100rpx; height: 100rpx; }
.ratio-5-3 { width: 125rpx; height: 75rpx; }
.ratio-2-1 { width: 140rpx; height: 70rpx; }

.box {
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  background: #fff;
  position: relative;
  box-sizing: border-box;
}

.line-h {
  position: absolute;
  left: 0;
  width: 100%;
  height: 2rpx;
  background: #ccc;
}
.mid-h { top: 50%; }
.one-h { top: 33.333%; }
.two-h { top: 66.666%; }
.q1 { top: 25%; }
.q2 { top: 50%; }
.q3 { top: 75%; }

.line-v {
  position: absolute;
  top: 0;
  width: 2rpx;
  height: 100%;
  background: #ccc;
}
.mid-v { left: 50%; }
.one-v { left: 33.333%; }
.two-v { left: 66.666%; }
.f1-v { left: 25%; }
.f2-v { left: 50%; }
.f3-v { left: 75%; }

.line-slash {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg,transparent 47%,#ccc 48%,#ccc 52%,transparent 53%);
}

.template-item.active .box{
  border-color: #ff5e78;
  background: #ffeef0;
}
.template-item.active .line-h,
.template-item.active .line-v,
.template-item.active .line-slash {
  background: #fff;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 0 30rpx 40rpx;
}
.select-btn, .save-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
}
.select-btn {
  border: 2rpx solid #007aff;
  color: #007aff;
  background: #fff;
}
.save-btn {
  background: #007aff;
  color: #fff;
}