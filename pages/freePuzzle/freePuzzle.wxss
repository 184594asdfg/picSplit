page {
  background: #f5f5f5;
}
.page-container {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
}
.preview-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}
.preview-stage {
  width: 100vw;
  height: 100%;
  background: #ffffff;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
  position: relative;
}

.puzzle-frame {
  position: relative;
  background: transparent;
}

.puzzle-cell {
  position: absolute;
  background: #000000;
  box-sizing: border-box;
  overflow: hidden;
}
.puzzle-cell.has-img {
  background: transparent;
}
.cell-inner {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.cell-img {
  position: absolute;
  display: block;
}

.drag-floating {
  position: fixed;
  z-index: 999;
  box-sizing: border-box;
  background: transparent;
  opacity: 0.88;
  pointer-events: none;
  box-shadow: 0 0 24rpx rgba(0,0,0,0.35);
  transition: none;
}

.save-canvas {
  position: fixed;
  left: -10000rpx;
  top: -10000rpx;
  width: 200rpx;
  height: 200rpx;
  pointer-events: none;
}

.bottom-panel {
  background: #fff;
  border-top-left-radius: 26rpx;
  border-top-right-radius: 26rpx;
  padding-bottom: env(safe-area-inset-bottom);
}
.collapse-btn {
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}
.arrow-icon {
  font-size: 30rpx;
  color: #ccc;
}
.template-section {
  padding: 0 30rpx 40rpx;
}
.section-title {
  font-size: 30rpx;
  color: #007aff;
  margin-bottom: 26rpx;
  display: flex;
  align-items: center;
  height: 60rpx;
  line-height: 60rpx;
  border-bottom: 2rpx solid #e5e5e5;
}
.template-scroll {
  white-space: nowrap;
}
.template-list {
  display: flex;
  align-items: center;
}

.left-template {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.split-line {
  width: 2rpx;
  height: 70rpx;
  background: #ccc !important;
  margin-left: 20rpx;
  display: block;
}

.template-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 25rpx;
}

.small-box {
  width: 60rpx !important;
  height: 60rpx !important;
}

.item-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

.ratio-4-5 { width: 80rpx; height: 100rpx; }
.ratio-1-1 { width: 100rpx; height: 100rpx; }
.ratio-5-3 { width: 125rpx; height: 75rpx; }
.ratio-2-1 { width: 140rpx; height: 70rpx; }

.box {
  border: 2rpx solid #333;
  border-radius: 8rpx;
  background: #000;
  position: relative;
  box-sizing: border-box;
}

/* 隐藏所有分割线，只保留外框 */
.box .line-h,
.box .line-v {
  display: none !important;
}

/* 选中仅边框变粉 */
.template-item.active .box {
  border-color: #ff7a9c;
  background: #000;
  border-width: 3rpx;
}

.left-icon-inner {
  position: absolute;
  inset: 0;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
.line-none {
  background: linear-gradient(135deg, transparent 48%, #ffffff 48%, #ffffff 52%, transparent 52%);
  border: none;
}
.line-small,
.line-medium,
.line-large {
  border: none;
}

.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 0 30rpx 0rpx;
}
.select-btn, .save-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.select-btn {
  border: 2rpx solid #007aff;
  color: #007aff;
  background: #fff;
}
.save-btn {
  background: #007aff;
  color: #fff;
}
