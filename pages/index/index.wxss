page {
  background: linear-gradient(180deg, #f4f6ff 0%, #eef1fb 50%, #f7f8fc 100%);
  min-height: 100vh;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 120rpx 40rpx 60rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.bg-decor {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.55;
  pointer-events: none;
  z-index: 0;
}

.bg-decor-1 {
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, #a0b6ff 0%, rgba(160, 182, 255, 0) 70%);
  top: -100rpx;
  right: -120rpx;
}

.bg-decor-2 {
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, #ffc7e0 0%, rgba(255, 199, 224, 0) 70%);
  top: 280rpx;
  left: -120rpx;
}

.hero {
  position: relative;
  z-index: 1;
  text-align: left;
  margin-bottom: 60rpx;
}

.hero-badge {
  display: inline-block;
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #6b7ae0;
  background: rgba(107, 122, 224, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 600;
  margin-bottom: 28rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 700;
  color: #1a1f36;
  line-height: 1.2;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.hero-subtitle {
  font-size: 26rpx;
  color: #7a83a3;
  line-height: 1.6;
}

.card-list {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.card {
  position: relative;
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(60, 70, 130, 0.08);
  transition: all 0.25s ease;
  overflow: hidden;
}

.card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 8rpx 0 0 8rpx;
}

.card-1::before {
  background: linear-gradient(180deg, #6b8cff, #8a6bff);
}

.card-2::before {
  background: linear-gradient(180deg, #ff7eb6, #ff9b6b);
}

.card-3::before {
  background: linear-gradient(180deg, #6bd9a6, #4fbf8f);
}

.card-hover {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 4rpx 16rpx rgba(60, 70, 130, 0.1);
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.card-1 .card-icon {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
}

.card-2 .card-icon {
  background: linear-gradient(135deg, #fff0f6, #ffe4d6);
}

.card-3 .card-icon {
  background: linear-gradient(135deg, #e6fff5, #d4f5e5);
}

.icon-grid {
  width: 52rpx;
  height: 52rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 4rpx;
}

.icon-cell {
  background: #6b8cff;
  border-radius: 4rpx;
}

.icon-free {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.icon-free-row {
  flex: 1;
  display: flex;
  gap: 4rpx;
}

.icon-free-cell {
  flex: 1;
  background: #ff7eb6;
  border-radius: 4rpx;
}

.icon-free-cell.wide {
  flex: 2;
}

.icon-puzzle {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.icon-puzzle-row {
  flex: 1;
  display: flex;
  gap: 4rpx;
}

.icon-puzzle-cell {
  flex: 1;
  background: #6bd9a6;
  border-radius: 4rpx;
}

.card-info {
  flex: 1;
  min-width: 0;
}

.card-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1f36;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #8a93b2;
  line-height: 1.4;
}

.card-arrow {
  font-size: 48rpx;
  color: #c5cce0;
  line-height: 1;
  margin-left: 12rpx;
  font-weight: 300;
}

.action-bar {
  position: relative;
  z-index: 1;
  margin-top: 60rpx;
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 70, 130, 0.06);
  line-height: 1;
  border: none;
  transition: all 0.2s ease;
}

.action-btn::after {
  border: none;
}

.action-hover {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(60, 70, 130, 0.08);
  background: #fafbff;
}

.action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.action-icon-share {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
}

.action-icon-feedback {
  background: linear-gradient(135deg, #fff0f6, #ffe4d6);
}

.share-dot {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #6b8cff;
}

.share-dot-1 {
  top: 10rpx;
  right: 12rpx;
}

.share-dot-2 {
  bottom: 10rpx;
  right: 12rpx;
}

.share-dot-3 {
  left: 12rpx;
  top: 50%;
  transform: translateY(-50%);
}

.share-line {
  position: absolute;
  width: 22rpx;
  height: 2rpx;
  background: #6b8cff;
  left: 18rpx;
}

.share-line-1 {
  top: 20rpx;
  transform: rotate(28deg);
  transform-origin: left center;
}

.share-line-2 {
  bottom: 19rpx;
  transform: rotate(-28deg);
  transform-origin: left center;
}

.chat-bubble {
  width: 36rpx;
  height: 28rpx;
  background: #ff7eb6;
  border-radius: 8rpx;
  position: relative;
}

.chat-bubble::after {
  content: '';
  position: absolute;
  bottom: -6rpx;
  left: 8rpx;
  width: 0;
  height: 0;
  border-left: 6rpx solid transparent;
  border-right: 6rpx solid transparent;
  border-top: 8rpx solid #ff7eb6;
}

.chat-dot {
  position: absolute;
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: #fff;
  top: 22rpx;
}

.chat-dot-1 {
  left: 19rpx;
}

.chat-dot-2 {
  left: 27rpx;
}

.chat-dot-3 {
  left: 35rpx;
}

.action-text {
  font-size: 26rpx;
  color: #4a5275;
  font-weight: 500;
}

.footer {
  position: relative;
  z-index: 1;
  text-align: center;
  margin-top: 80rpx;
  font-size: 22rpx;
  color: #b4bdda;
  letter-spacing: 2rpx;
}
