<view class="page">
  <view class="bg-decor bg-decor-1"></view>
  <view class="bg-decor bg-decor-2"></view>

  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top:{{statusBarHeight}}px;">
    <view class="nav-content" style="height:{{navBarHeight}}px;">
      <view class="nav-back" bindtap="onBack" hover-class="nav-back-hover">
        <view class="back-arrow"></view>
      </view>
      <view class="nav-title">切图结果</view>
    </view>
  </view>
  <view class="nav-placeholder" style="height:{{statusBarHeight + navBarHeight}}px;"></view>

  <!-- 顶部成功提示 -->
  <view class="hero">
    <view class="hero-badge">
      <view class="badge-dot"></view>
      <text>处理完成</text>
    </view>
    <view class="hero-title">已为你生成 {{previewList.length}} 张图片</view>
    <view class="hero-subtitle">点击图片可预览，长按可保存到相册</view>
  </view>

  <!-- 操作区：卡片化按钮 -->
  <view class="action-section">
    <view class="action-card {{source === 'grid' ? 'action-card-active' : ''}}" bindtap="onActionTap" data-action="grid" hover-class="action-hover">
      <view class="action-icon-wrap action-icon-grid">
        <view class="ic-grid">
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
          <view class="ic-grid-cell"></view>
        </view>
      </view>
      <text class="action-text">{{gridLabel}}</text>
    </view>

    <view class="action-card {{source === 'free' ? 'action-card-active' : ''}}" bindtap="onActionTap" data-action="collage" hover-class="action-hover">
      <view class="action-icon-wrap action-icon-collage">
        <view class="ic-free">
          <view class="ic-free-row">
            <view class="ic-free-cell"></view>
            <view class="ic-free-cell wide"></view>
          </view>
          <view class="ic-free-row">
            <view class="ic-free-cell wide"></view>
            <view class="ic-free-cell"></view>
          </view>
        </view>
      </view>
      <text class="action-text">{{collageLabel}}</text>
    </view>

    <view class="action-card {{source === 'puzzle' ? 'action-card-active' : ''}}" bindtap="onActionTap" data-action="puzzle" hover-class="action-hover">
      <view class="action-icon-wrap action-icon-puzzle">
        <view class="ic-puzzle">
          <view class="ic-puzzle-row">
            <view class="ic-puzzle-cell"></view>
            <view class="ic-puzzle-cell"></view>
          </view>
          <view class="ic-puzzle-row">
            <view class="ic-puzzle-cell"></view>
            <view class="ic-puzzle-cell"></view>
          </view>
        </view>
      </view>
      <text class="action-text">{{puzzleLabel}}</text>
    </view>

    <button class="action-card action-btn" open-type="share" hover-class="action-hover">
      <view class="action-icon-wrap action-icon-share">
        <view class="ic-share">
          <view class="ic-share-dot ic-share-dot-1"></view>
          <view class="ic-share-dot ic-share-dot-2"></view>
          <view class="ic-share-dot ic-share-dot-3"></view>
          <view class="ic-share-line ic-share-line-1"></view>
          <view class="ic-share-line ic-share-line-2"></view>
        </view>
      </view>
      <text class="action-text">分享</text>
    </button>
  </view>

  <!-- 下载顺序 / 拼图效果图 -->
  <view class="order-section">
    <view class="order-line"></view>
    <view class="order-title">{{previewTitle}}</view>
    <view class="order-line"></view>
  </view>

  <!-- 宫格预览区 -->
  <view class="preview-grid {{gridColumns === 3 ? 'cols-3' : (gridColumns === 1 ? 'cols-1' : 'cols-4')}}">
    <view
      wx:for="{{previewList}}"
      wx:key="index"
      class="preview-item"
      bindtap="onPreviewTap"
      data-index="{{index}}"
      hover-class="preview-hover"
    >
      <image
        wx:if="{{item}}"
        class="preview-image"
        src="{{item}}"
        mode="widthFix"
      />
      <view class="order-number">{{index + 1}}</view>
    </view>
  </view>

  <view class="footer-tip">
    <text>· 已是全部内容 ·</text>
  </view>
</view>
