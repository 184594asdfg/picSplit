page {
  background-color: #2c2c34;
  color: #ffffff;
}

.container {
  min-height: 100vh;
  max-width: 480px;
  margin: 0 auto;
  overflow-x: hidden;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background-color: #2c2c34;
}

.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
  margin-left: 10rpx;
}

.nav-back:active {
  opacity: 0.6;
}

.nav-title {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 500;
}

.nav-placeholder {
  width: 100%;
}

/* 功能按钮区 */
.action-section {
  display: flex;
  justify-content: space-around;
  align-items: flex-start;
  padding: 24px 16px;
  gap: 16px;
  position: relative;
}

.action-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  max-width: 120px;
}
.action-item:active {
  transform: scale(0.95);
}

/* 分享按钮（button）重置：外观与普通 action-item 一致 */
.action-btn {
  background-color: transparent;
  padding: 0;
  margin: 0;
  border: none;
  line-height: normal;
  border-radius: 0;
}
.action-btn::after {
  border: none;
}

.action-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #ffffff;
}

.action-text {
  font-size: 15px;
  color: #ffffff;
  text-align: center;
  line-height: 1.2;
}

/* 功能按钮配色 */
.icon-grid { background-color: #e91e63; }
.icon-collage { background-color: #f44336; }
.icon-split { background-color: #5c6bc0; }
.icon-share { background-color: #4caf50; }

/* 下载顺序标题 */
.order-title {
  text-align: center;
  font-size: 22px;
  font-weight: 500;
  margin: 16px 0 8px;
  letter-spacing: 1px;
}

.expand-icon {
  text-align: center;
  font-size: 20px;
  margin-bottom: 24px;
  color: rgba(255,255,255,0.7);
}

/* 宫格预览区：图片按原比例自适应 */
.preview-grid {
  display: grid;
  gap: 8px;
  padding: 0 12px 40px;
}

/* 九宫格切图：一行 3 张 */
.preview-grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

/* 其他来源：一行 4 张（默认） */
.preview-grid.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* 拼图结果：单张大图 */
.preview-grid.cols-1 {
  grid-template-columns: 1fr;
  padding: 0 16px 40px;
}
.preview-grid.cols-1 .order-number {
  display: none;
}

.preview-item {
  position: relative;
  background-color: transparent;
  border-radius: 4px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-item:active {
  transform: scale(0.98);
}

.preview-image {
  width: 100%;
  height: auto;
  display: block;
}

.order-number {
  position: absolute;
  top: 0;
  left: 0;
  width: 32px;
  height: 32px;
  background-color: #2196f3;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 600;
}

/* 移动端适配 */
@media (max-width: 375px) {
  .action-section {
    gap: 8px;
    padding: 20px 12px;
  }
  .action-item {
    max-width: 100px;
  }
  .action-icon {
    width: 56px;
    height: 56px;
    font-size: 24px;
  }
  .action-text {
    font-size: 13px;
  }
  .preview-grid {
    gap: 12px;
    padding: 0 12px 32px;
  }
  .preview-grid.cols-3 {
    gap: 8px;
  }
  .order-number {
    width: 24px;
    height: 24px;
    font-size: 14px;
  }
}
