page {
  background: linear-gradient(180deg, #f4f6ff 0%, #eef1fb 50%, #f7f8fc 100%);
  min-height: 100vh;
  color: #1a1f36;
}

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 背景装饰光斑 */
.bg-decor {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.55;
  pointer-events: none;
  z-index: 0;
}
.bg-decor-1 {
  width: 420rpx;
  height: 420rpx;
  background: radial-gradient(circle, #a0b6ff 0%, rgba(160, 182, 255, 0) 70%);
  top: -120rpx;
  right: -140rpx;
}
.bg-decor-2 {
  width: 380rpx;
  height: 380rpx;
  background: radial-gradient(circle, #ffc7e0 0%, rgba(255, 199, 224, 0) 70%);
  top: 320rpx;
  left: -140rpx;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: rgba(244, 246, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-back {
  position: absolute;
  left: 16rpx;
  top: 0;
  bottom: 0;
  width: 72rpx;
  height: 72rpx;
  margin: auto 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(60, 70, 130, 0.08);
  transition: all 0.2s ease;
}
.nav-back-hover {
  transform: scale(0.92);
  opacity: 0.8;
}
.back-arrow {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #4a5275;
  border-bottom: 4rpx solid #4a5275;
  transform: rotate(45deg);
  margin-left: 8rpx;
  border-radius: 1rpx;
}
.nav-title {
  font-size: 32rpx;
  color: #1a1f36;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.nav-placeholder {
  width: 100%;
}

/* 顶部 Hero */
.hero {
  position: relative;
  z-index: 1;
  padding: 40rpx 40rpx 16rpx;
  text-align: left;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #4fbf8f;
  background: rgba(79, 191, 143, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}
.badge-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #4fbf8f;
  box-shadow: 0 0 0 4rpx rgba(79, 191, 143, 0.2);
  animation: pulse 1.6s ease-in-out infinite;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.2); }
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1f36;
  line-height: 1.3;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}
.hero-subtitle {
  font-size: 24rpx;
  color: #7a83a3;
  line-height: 1.5;
}

/* 操作卡片区 */
.action-section {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  padding: 32rpx 32rpx 12rpx;
  gap: 16rpx;
}
.action-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 12rpx 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 70, 130, 0.06);
  transition: all 0.2s ease;
  line-height: 1;
  border: none;
  min-width: 0;
}
.action-card.action-btn {
  margin: 0;
}
.action-card.action-btn::after {
  border: none;
}
.action-hover {
  transform: translateY(2rpx) scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(60, 70, 130, 0.08);
  background: #fafbff;
}

/* 来源高亮：当前来源的按钮文字加重，并在底部显示一条彩色指示条 */
.action-card-active {
  position: relative;
  background: #ffffff;
}
.action-card-active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  transform: translateX(-50%);
  width: 32rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, #6b8cff, #8a6bff);
}
.action-card-active .action-text {
  color: #1a1f36;
  font-weight: 600;
}

.action-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.action-icon-grid {
  background: linear-gradient(135deg, #eef2ff, #e0e7ff);
}
.action-icon-collage {
  background: linear-gradient(135deg, #fff0f6, #ffe4d6);
}
.action-icon-puzzle {
  background: linear-gradient(135deg, #e6fff5, #d4f5e5);
}
.action-icon-share {
  background: linear-gradient(135deg, #fff7e6, #ffe9c2);
}

/* 九宫格图标 */
.ic-grid {
  width: 40rpx;
  height: 40rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  gap: 3rpx;
}
.ic-grid-cell {
  background: #6b8cff;
  border-radius: 3rpx;
}

/* 自由切图图标 */
.ic-free {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.ic-free-row {
  flex: 1;
  display: flex;
  gap: 3rpx;
}
.ic-free-cell {
  flex: 1;
  background: #ff7eb6;
  border-radius: 3rpx;
}
.ic-free-cell.wide {
  flex: 2;
}

/* 自由拼图图标 */
.ic-puzzle {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}
.ic-puzzle-row {
  flex: 1;
  display: flex;
  gap: 3rpx;
}
.ic-puzzle-cell {
  flex: 1;
  background: #4fbf8f;
  border-radius: 3rpx;
}

/* 分享图标 */
.ic-share {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}
.ic-share-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f5a623;
}
.ic-share-dot-1 {
  top: 4rpx;
  right: 6rpx;
}
.ic-share-dot-2 {
  bottom: 4rpx;
  right: 6rpx;
}
.ic-share-dot-3 {
  left: 6rpx;
  top: 50%;
  transform: translateY(-50%);
}
.ic-share-line {
  position: absolute;
  width: 18rpx;
  height: 2rpx;
  background: #f5a623;
  left: 12rpx;
}
.ic-share-line-1 {
  top: 12rpx;
  transform: rotate(28deg);
  transform-origin: left center;
}
.ic-share-line-2 {
  bottom: 11rpx;
  transform: rotate(-28deg);
  transform-origin: left center;
}

.action-text {
  font-size: 24rpx;
  color: #4a5275;
  text-align: center;
  font-weight: 500;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* 下载顺序分隔 */
.order-section {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin: 36rpx 40rpx 24rpx;
}
.order-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(122, 131, 163, 0.25), transparent);
}
.order-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #4a5275;
  letter-spacing: 4rpx;
}

/* 宫格预览区 */
.preview-grid {
  position: relative;
  z-index: 1;
  display: grid;
  gap: 12rpx;
  padding: 0 32rpx;
}
.preview-grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}
.preview-grid.cols-4 {
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
}
.preview-grid.cols-1 {
  grid-template-columns: 1fr;
  padding: 0 40rpx;
}
.preview-grid.cols-1 .order-number {
  display: none;
}

.preview-item {
  position: relative;
  background: #ffffff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(60, 70, 130, 0.08);
  transition: all 0.2s ease;
}
.preview-hover {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(60, 70, 130, 0.06);
}

.preview-image {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 16rpx;
}

.order-number {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #6b8cff, #8a6bff);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 10rpx rgba(107, 140, 255, 0.4);
  letter-spacing: 0;
}

/* 拼图（单图）大图：与预览保持一致，不带圆角 */
.preview-grid.cols-1 .preview-item {
  border-radius: 0;
  overflow: visible;
  background: transparent;
  box-shadow: none;
}
.preview-grid.cols-1 .preview-image {
  border-radius: 0;
}

.footer-tip {
  position: relative;
  z-index: 1;
  text-align: center;
  margin-top: 48rpx;
  font-size: 22rpx;
  color: #b4bdda;
  letter-spacing: 4rpx;
}

/* 小屏适配 */
@media (max-width: 375px) {
  .hero {
    padding: 32rpx 32rpx 12rpx;
  }
  .hero-title {
    font-size: 38rpx;
  }
  .action-section {
    padding: 24rpx 24rpx 8rpx;
    gap: 12rpx;
  }
  .action-card {
    padding: 20rpx 8rpx 18rpx;
    gap: 10rpx;
  }
  .action-icon-wrap {
    width: 68rpx;
    height: 68rpx;
    border-radius: 18rpx;
  }
  .ic-grid, .ic-free, .ic-puzzle, .ic-share {
    width: 36rpx;
    height: 36rpx;
  }
  .action-text {
    font-size: 22rpx;
  }
  .preview-grid {
    padding: 0 24rpx;
  }
  .preview-grid.cols-4 {
    gap: 8rpx;
  }
  .order-number {
    min-width: 32rpx;
    height: 32rpx;
    font-size: 20rpx;
  }
}
