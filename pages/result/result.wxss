page {
  background-color: #2c2c34;
  color: #ffffff;
}

.container {
  min-height: 100vh;
  max-width: 480px;
  margin: 0 auto;
  overflow-x: hidden;
}

/* 顶部导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background-color: #2c2c34;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  color: #ffffff;
}
.back-btn:active {
  opacity: 0.7;
}

.page-title {
  font-size: 20px;
  font-weight: 500;
  color: #ffffff;
  letter-spacing: 0.5px;
}

.window-controls {
  display: flex;
  gap: 12px;
  align-items: center;
  background-color: rgba(255,255,255,0.1);
  padding: 6px 12px;
  border-radius: 16px;
}

.window-btn {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  color: #ffffff;
}

/* 功能按钮区 */
.action-section {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 24px 16px;
  gap: 16px;
  position: relative;
}

/* 功能区右侧分割线 */
.action-section::after {
  content: '';
  position: absolute;
  right: 25%;
  top: 20%;
  height: 60%;
  width: 1px;
  background-color: rgba(255,255,255,0.2);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
}
.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  color: #ffffff;
}

.action-text {
  font-size: 15px;
  color: #ffffff;
  text-align: center;
  line-height: 1.2;
}

/* 功能按钮配色 */
.icon-grid { background-color: #e91e63; }
.icon-collage { background-color: #f44336; }
.icon-split { background-color: #5c6bc0; }
.icon-share { background-color: #4caf50; }

/* 下载顺序标题 */
.order-title {
  text-align: center;
  font-size: 22px;
  font-weight: 500;
  margin: 16px 0 8px;
  letter-spacing: 1px;
}

.expand-icon {
  text-align: center;
  font-size: 20px;
  margin-bottom: 24px;
  color: rgba(255,255,255,0.7);
}
.expand-icon:active {
  transform: rotate(180deg);
}

/* 宫格预览区 */
.preview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  padding: 0 16px 40px;
}

.preview-item {
  position: relative;
  background-color: #ffffff;
  border-radius: 4px;
  overflow: hidden;
  aspect-ratio: 1 / 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.preview-item:active {
  transform: scale(0.98);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.order-number {
  position: absolute;
  top: 0;
  left: 0;
  width: 32px;
  height: 32px;
  background-color: #2196f3;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 600;
}

/* 移动端适配 */
@media (max-width: 375px) {
  .action-section {
    gap: 8px;
    padding: 20px 12px;
  }
  .action-icon {
    width: 56px;
    height: 56px;
    font-size: 24px;
  }
  .action-text {
    font-size: 13px;
  }
  .preview-grid {
    gap: 12px;
    padding: 0 12px 32px;
  }
}
